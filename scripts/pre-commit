#!/bin/sh
# Stage 2 Extended's git pre-commit hook. Install with `python scripts/install_hooks.py`, which copies this into the
# hooks directory of `git rev-parse --git-common-dir`, so the main tree and every worktree share it.
#
# Runs (1) the vendored snapshot's integrity -- `python scripts/vendor_stage2.py --verify`: every file of vendor/stage2
# against vendor/MANIFEST_stage2.sha256 and, where the bars and atlas are present (a copy here, junctions in a
# worktree), the data against vendor/DATA_MANIFEST_stage2.sha256 (E-002) --, (2) the licence check on the commit's own
# index -- `python scripts/check_price_levels.py --index`: no tracked or staged CSV outside vendor/ holds or reveals an
# NQ price level (Q-131) -- and (3) the suite's FAST tier (-m "not slow and not heavy"). A commit that breaks either is refused: a broken foundation committed is a broken
# foundation someone later trusts. The fast tier runs one at a time on the machine (Q-155): through
# `scripts/fasttier_lock.py run`, which takes the machine-wide lock %LOCALAPPDATA%\stage2-extended-fasttier.lock (waiting
# for a live holder, taking over a dead or 2-hour-old one), waits until 1.5 GB of physical memory is free, and fails the
# hook after 3 hours of waiting -- never a silent pass. The identity (`slow`), anything `heavy` and the vendored stage-one suite run in
# /validate, never here.
#
# IN PARALLEL (Q-193). Inside its slot the fast tier runs through `scripts/fasttier_xdist.py`: pytest-xdist with n
# workers, n chosen from the memory free when the slot is taken (1 to 4; n = 1 is the serial command, unchanged). The
# parallel run must hold exactly the serial collection's tests; the tests that failed in parallel, and only those, are
# rerun serially; the commit passes only if each passed in one or the other, and the verdict line names every test
# that passed only serially (an isolation defect to fix). Same selection, same markers.
#
# THE VERDICT (Q-161). A commit is written only when the fast tier itself returned 0.
#   * Git for Windows reads a hook's exit status as the LOW BYTE of its Windows exit code, and the MSYS runtime gives a
#     shell killed by signal N the exit code N << 8 (SIGTERM 0xF00, SIGKILL 0x900, SIGPIPE 0xD00): a killed hook reads
#     as exit 0, a pass. `timeout 3000 git commit` wrote 3451a10 that way on 2026-11-18 while its fast tier still ran.
#     So this shell never dies of a signal it can catch: HUP, INT, QUIT and TERM are trapped (the child's process tree
#     is killed and the hook exits 128+N, which git reads as a refusal); SIGPIPE is ignored, so a closed output pipe
#     makes a write fail and the hook exit non-zero. Every step runs as a background child the shell `wait`s for, so a
#     trap runs at once, not after the child ends. There is no re-exec (it put a second shell between git and the traps).
#   * SIGKILL cannot be trapped. The hook writes <git-dir>/fasttier-pending (the commit's tree) before its checks,
#     removes it on every exit it lives to make, and records a verdict only after the fast tier returned 0; the
#     commit-msg hook (which git runs after this one and before it writes the commit) refuses a commit whose tree is
#     pending without a verdict.
#   * On success the verdict -- tree, UTC time, worktree, pytest's pass line -- is appended to
#     <git-common-dir>/fasttier-verdicts.log; the post-commit hook warns about a commit without one, and
#     `python scripts/check_verdicts.py <range>` lists such commits for the merge checklist.
#
# THE TREE. Every path the hook uses is the tree the commit is made in: the git directory git commits into, its index,
# and that git directory's own worktree, resolved before the inherited GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE are
# cleared. If they disagree (git committing into one tree while the hook would check another), the commit is refused.
#
# Run by hand only under git's own sh: `"$(git var GIT_SHELL_PATH)" .git/hooks/pre-commit`. On Windows `bash` on PATH
# can be WSL's, which cannot see this checkout the way git does.
#
# Bypass with `git commit --no-verify` only when you know why; say so in the commit message (the post-commit hook
# records such a commit as NO VERDICT).

set -e

# ------------------------------------------------------------------------------------------------ signals first
CHILD=
PENDING=

kill_tree() {
    # The child's whole process tree. On Windows a native child (python, and pytest under it) is killed with
    # taskkill /T, found from the MSYS pid's Windows pid; elsewhere the child gets SIGTERM (fasttier_lock.py then
    # releases its lock and kills pytest).
    _pid=$1
    _wp=
    if [ -r "/proc/$_pid/winpid" ]; then
        _wp=$(cat "/proc/$_pid/winpid" 2>/dev/null) || _wp=
    fi
    if [ -n "$_wp" ] && command -v taskkill >/dev/null 2>&1; then
        MSYS2_ARG_CONV_EXCL='*' taskkill /T /F /PID "$_wp" >/dev/null 2>&1 || :
    fi
    kill -TERM "$_pid" 2>/dev/null || :
}

on_signal() {
    trap '' HUP INT QUIT TERM
    echo "pre-commit: killed by SIG$1 before the fast tier returned; the commit is REFUSED (exit $2)." >&2 || :
    if [ -n "$CHILD" ]; then
        kill_tree "$CHILD"
    fi
    exit "$2"
}

trap '' PIPE
trap 'on_signal HUP 129' HUP
trap 'on_signal INT 130' INT
trap 'on_signal QUIT 131' QUIT
trap 'on_signal TERM 143' TERM
trap 'if [ -n "$PENDING" ]; then rm -f "$PENDING"; fi' EXIT

# Run a step as a background child and wait for it, so that a trapped signal is handled at once (a shell waiting on a
# foreground child runs its trap only after the child ends).
run_child() {
    "$@" &
    CHILD=$!
    _rc=0
    wait "$CHILD" || _rc=$?
    CHILD=
    return "$_rc"
}

refuse() {
    echo "pre-commit: $1" >&2 || :
    shift
    for _line in "$@"; do
        echo "pre-commit: $_line" >&2 || :
    done
    exit 1
}

# ------------------------------------------------------------------------------------------------ the tree committed
# Resolved with the environment git gave this hook: these are what git commits into.
GITDIR=$(git rev-parse --absolute-git-dir) || refuse "cannot find the git directory this commit is made in."
COMMON=$(git rev-parse --path-format=absolute --git-common-dir) || refuse "cannot find the common git directory."
TOP=$(git rev-parse --show-toplevel) || refuse "cannot find the work tree this hook runs in."

# The index this commit records. `git commit -a` or `git commit <paths>` stages into a temporary index named by
# GIT_INDEX_FILE, so the licence check below reads that one; it is kept here before the environment is cleared.
COMMIT_INDEX="${GIT_INDEX_FILE:-}"

# The commit's tree, from that index: the verdict's key (git writes the same tree when it commits).
TREE=$(git write-tree) || refuse "cannot write the index's tree (unmerged paths?); the commit is refused."
PENDING="$GITDIR/fasttier-pending"
printf '%s\n' "$TREE" > "$PENDING" || refuse "cannot write $PENDING; the commit is refused."

# The worktree that owns GITDIR: a linked worktree's git directory names it in its `gitdir` file (<tree>/.git); the
# main repository's is core.worktree or the parent of its .git.
OWN=
if [ -f "$GITDIR/gitdir" ]; then
    OWN=$(sed -n 1p "$GITDIR/gitdir")
    OWN=${OWN%/.git}
elif _wt=$(git config --get core.worktree 2>/dev/null) && [ -n "$_wt" ]; then
    case "$_wt" in
        /* | [A-Za-z]:*) OWN=$_wt ;;
        *) OWN="$GITDIR/$_wt" ;;
    esac
elif [ "${GITDIR##*/}" = ".git" ]; then
    OWN=${GITDIR%/.git}
fi
if [ -z "$OWN" ] || ! [ "$TOP" -ef "$OWN" ]; then
    refuse "REFUSED: git is committing into $GITDIR, whose work tree is ${OWN:-unknown}, but this hook would check $TOP." \
        "The inherited GIT_DIR='${GIT_DIR:-}' GIT_WORK_TREE='${GIT_WORK_TREE:-}' point the commit and the checked tree at different trees." \
        "Unset them (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE) and commit from the tree you mean."
fi
if [ -n "$COMMIT_INDEX" ] && ! [ "$(dirname "$COMMIT_INDEX")" -ef "$GITDIR" ]; then
    refuse "REFUSED: the index being committed ($COMMIT_INDEX) is not in this tree's git directory ($GITDIR)." \
        "An inherited GIT_INDEX_FILE names another index; unset it and commit again."
fi

# git exports GIT_INDEX_FILE (and, depending on the invocation, GIT_DIR / GIT_WORK_TREE / GIT_PREFIX) to its hooks.
# Inherited by the suite, they would point every nested `git` -- a test that builds a temporary repository, the
# provenance code, `git ls-files` in tests/test_vendor_integrity.py -- at this commit's index (Stage 2 saw a fixture's
# `git add` stage its file into the real index). The checks must see the environment a shell gives them.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

REPO_ROOT=$TOP
cd "$REPO_ROOT"

# Pick a Python that actually runs. `command -v python3` is not enough on Windows: the App Execution Alias stubs for
# python3.exe and python.exe exist on PATH and resolve, but running them prints "Python was not found" and exits
# non-zero. So each candidate is *executed* rather than merely located.
pick_python() {
    for candidate in "$PYTHON" python3 python py; do
        [ -n "$candidate" ] || continue
        if "$candidate" -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

PYTHON=$(pick_python) || {
    echo "pre-commit: no working python interpreter found (tried \$PYTHON, python3, python, py)." >&2
    echo "pre-commit: set PYTHON to a working interpreter, or commit with --no-verify and say why." >&2
    exit 1
}

# Keep .pyc files out of the read-only vendored tree (E-002).
export PYTHONDONTWRITEBYTECODE=1

# The fast tier: every test not marked slow or heavy in pyproject.toml (the same selection scripts/hooks/run_tests.py
# runs after a .py edit). `-o addopts=` clears the project's own `-q`; inherited, the two compound into -qq and the
# pass count is suppressed.
FAST_TIER="not slow and not heavy"

BRANCH=$(git symbolic-ref -q --short HEAD 2>/dev/null) || BRANCH="(detached)"
echo "pre-commit: vendor integrity + the licence check + the fast tier (-m \"$FAST_TIER\"), python = $PYTHON, tree = $REPO_ROOT, branch = $BRANCH, index tree = $TREE"

echo "--- vendor integrity (scripts/vendor_stage2.py --verify) ---"
# The check must stop the hook on failure on every branch. `set -e` does not fire inside an `a && b` list or on the
# left of `||`, so the failure is caught explicitly: vendor_stage2.py --verify prints FAILED and exits 3 on any changed,
# missing or extra file (or a data mismatch), 0 when everything matches.
vendor_failed() {
    echo "pre-commit: vendor integrity FAILED -- vendor/stage2 or its data differ from their manifests (E-002)." >&2
    echo "pre-commit: restore the snapshot (never re-pin it) and find what wrote to it." >&2
    exit 1
}
run_child "$PYTHON" scripts/vendor_stage2.py --verify || vendor_failed

echo "--- result files: no licensed price level (scripts/check_price_levels.py --index) ---"
# Every tracked or staged .csv/.tsv outside vendor/, as this commit's index holds it: a level column, a column of levels
# on the 0.25 grid, a pair a/b or 100 a/b that recovers one (Q-121's x_pts beside x_pct), intraday timestamps beside a
# price-class column. Exit 1 on a refusal or a stale allow-list entry (tests/price_level_allowlist.csv); it prints
# file and column names and shares, never a value.
price_level_failed() {
    echo "pre-commit: the licence check REFUSED the commit -- a staged CSV may hold or reveal an NQ price level (E-002)." >&2
    echo "pre-commit: unstage the file (git restore --staged <file>); never commit it to see what happens." >&2
    exit 1
}
# The hook is shared by every worktree (install_hooks.py): a tree made before the check existed has no script to run,
# and is refused rather than let through unchecked -- merge master into it first.
if [ ! -f scripts/check_price_levels.py ]; then
    echo "pre-commit: scripts/check_price_levels.py is missing from this tree; merge master (Q-131) and commit again." >&2
    exit 1
fi
run_child "$PYTHON" scripts/check_price_levels.py --index "$COMMIT_INDEX" || price_level_failed

echo "--- tests, fast tier (one at a time on the machine: scripts/fasttier_lock.py) ---"
# Several trees' fast tiers at once ran the machine out of memory (MemoryError, OpenBLAS, WinError 1455; Q-155). The
# wrapper holds the lock for exactly the pytest run, releases it on every exit, and returns pytest's own exit code; a
# wait that runs out exits 75. Like the licence check, a tree without the script is refused, never run unlocked.
if [ ! -f scripts/fasttier_lock.py ]; then
    echo "pre-commit: scripts/fasttier_lock.py is missing from this tree; merge master (Q-155) and commit again." >&2
    exit 1
fi
# The wrapper copies pytest's output into this tree's own git directory (never a shared scratch file), for the
# verdict's pass line and for reading afterwards (S2X_FASTTIER_TEE; it is not passed on to pytest).
FT_OUT="$GITDIR/fasttier-last.log"
rm -f "$FT_OUT"
S2X_FASTTIER_TEE=$FT_OUT
export S2X_FASTTIER_TEE
# Q-193: inside its slot the fast tier runs in parallel (pytest-xdist), with n workers chosen from the memory free at
# the moment the slot is taken: scripts/fasttier_xdist.py. n = 1 runs the very command below; n >= 2 checks that the
# parallel run held exactly the serial collection's tests, reruns only the tests that failed in parallel, serially, and
# passes only if each passed in one or the other (a test that passed only serially is named in the verdict as an
# isolation defect). The selection is the same either way. A tree without the script runs the serial command, as
# before (not checked by less: it is the command that tree always ran).
set +e
if [ -f scripts/fasttier_xdist.py ]; then
    run_child "$PYTHON" scripts/fasttier_lock.py run -- "$PYTHON" scripts/fasttier_xdist.py --work "$GITDIR/fasttier-xdist" -m "$FAST_TIER"
else
    run_child "$PYTHON" scripts/fasttier_lock.py run -- "$PYTHON" -m pytest -o addopts= -q -m "$FAST_TIER"
fi
FT_RC=$?
set -e
unset S2X_FASTTIER_TEE
if [ "$FT_RC" -ne 0 ]; then
    refuse "the fast tier FAILED (exit $FT_RC); the commit is refused. Its output: $FT_OUT"
fi

# The verdict: written only here, after the fast tier itself returned 0. Its pass line is the last line holding
# "<k> passed": pytest's own when the run was serial, scripts/fasttier_xdist.py's verdict line when parallel (the count
# over both runs, n, and every test that passed only in the serial rerun). A tab would split the log's record: none.
SUMMARY=$(grep -E '[0-9]+ passed' "$FT_OUT" 2>/dev/null | tail -n 1 | tr -d '\r' | tr '\t' ' ') || SUMMARY=
[ -n "$SUMMARY" ] || SUMMARY="-"
NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '%s\t%s\t%s\t%s\n' "$TREE" "$NOW" "$REPO_ROOT" "$SUMMARY" >> "$COMMON/fasttier-verdicts.log" ||
    refuse "the fast tier passed but its verdict could not be recorded in $COMMON/fasttier-verdicts.log; the commit is refused."

echo "pre-commit: OK (fast tier; the identity, the heavy tier and the vendored stage-one suite run in /validate)"
echo "pre-commit: verdict recorded for tree $TREE ($SUMMARY) in $COMMON/fasttier-verdicts.log; full output $FT_OUT"
