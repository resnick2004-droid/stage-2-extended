{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__quantconnect__authorize_connection",
      "mcp__quantconnect__create_live_algorithm",
      "mcp__quantconnect__read_live_algorithm",
      "mcp__quantconnect__list_live_algorithms",
      "mcp__quantconnect__read_live_chart",
      "mcp__quantconnect__read_live_logs",
      "mcp__quantconnect__read_live_portfolio",
      "mcp__quantconnect__read_live_orders",
      "mcp__quantconnect__read_live_insights",
      "mcp__quantconnect__stop_live_algorithm",
      "mcp__quantconnect__liquidate_live_algorithm",
      "mcp__quantconnect__create_live_command",
      "mcp__quantconnect__broadcast_live_command",
      "mcp__quantconnect__read_live_holdings",
      "mcp__quantconnect__search_live_logs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/protect_vendor.py\"", "timeout": 20},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/protect_results.py\"", "timeout": 20},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/decisions_append_only.py\"", "timeout": 20}
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/qc_no_live_trading.py\"", "timeout": 20}
        ]
      },
      {
        "matcher": "mcp__.*[Qq]uant[Cc]onnect.*",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/qc_window_guard.py\"", "timeout": 20}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/run_tests.py\"", "timeout": 900}
        ]
      }
    ]
  },
  "env": {"PYTHONDONTWRITEBYTECODE": "1"}
}
