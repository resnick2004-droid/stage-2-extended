# The operator's Databento bars (licensed for private use, never redistributed) and the atlas walks derived from them:
# copied into the vendored tree by scripts/vendor_stage2.py --data, hashed in vendor/DATA_MANIFEST_stage2.sha256,
# never committed.
vendor/stage2/data/bars/
vendor/stage2/data/atlas/
data/bars/
data/atlas/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# Scratch output
results/scratch/
# The fast tier's last run, written by scripts/hooks/run_tests.py (live state, never committed)
results/.last_test_run.json
results/*.png
results/*.parquet

# OS / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# Claude Code local settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# The heavy-run lock (E-005): live state, never committed
run.lock

# Licensed-price derivatives (E-179): result files from which a bar price can be recovered stay local, never committed
results/q121_vol_descriptive_a1.csv
results/q121_vol_descriptive_a1.csv.manifest.json
results/s1_range.csv
results/s1_range.csv.manifest.json

# A worker's commit-message file, written in its own worktree (E-210; skill worker-protocol): never staged
.commit_msg_*

# H4 worker scratch (backups, patches, mutant runners) in its own worktree: never staged (rn-1 of H4_DECL_c1)
.h4_dev/
