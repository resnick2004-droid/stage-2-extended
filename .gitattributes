# Line-ending policy. The LAST matching line wins: the general rule first, the exceptions after.
* text=auto

# The vendored Stage 2 snapshot is pinned byte-for-byte by vendor/MANIFEST_stage2.sha256 (E-002). Git must never
# transform it: a CRLF conversion on checkout would change every text file's hash and make the integrity test report a
# corrupted foundation where there is none.
vendor/** -text

# Result CSVs are hashed in their sidecar manifests, for the same reason.
results/*.csv -text

*.sh text eol=lf
# The git hooks run under git's sh: a CRLF checkout (core.autocrlf=true) would break them once installed.
scripts/pre-commit text eol=lf
scripts/commit-msg text eol=lf
scripts/post-commit text eol=lf
scripts/pre-merge-commit text eol=lf

# The read ledger of the judged block (Q-32) is append-only and compared line by line across commits: LF everywhere,
# so a checkout never rewrites its lines.
results/read_ledger.jsonl text eol=lf
